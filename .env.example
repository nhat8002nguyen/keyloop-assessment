# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
GLOBAL_TIMEOUT_MS=5000

# Logging (nestjs-pino JSON). LOG_TO_FILE=true writes logs/aggregate.jsonl for Filebeat → Elasticsearch (see README observability).
LOG_LEVEL=
LOG_TO_FILE=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local: docker-compose db service
# Managed: set DB_HOST to your RDS / Cloud SQL endpoint, DB_SSL=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=aggregate_service
DB_SSL=false

# ── Redis / Cache ─────────────────────────────────────────────────────────────
# Local: docker-compose redis service
# Managed: ElastiCache → set REDIS_TLS_ENABLED=true
#          Upstash     → set REDIS_HOST, REDIS_PASSWORD, REDIS_TLS_ENABLED=true
#          Cluster     → set REDIS_CLUSTER_MODE=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
REDIS_CLUSTER_MODE=false

# ── Kafka / Message Queue ─────────────────────────────────────────────────────
# Local: docker-compose kafka service
# MSK:        KAFKA_BROKERS=b-1.xxx.kafka.us-east-1.amazonaws.com:9096,...
#             KAFKA_SSL_ENABLED=true, KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# Confluent:  KAFKA_BROKERS=pkc-xxx.us-east1.gcp.confluent.cloud:9092
#             KAFKA_SSL_ENABLED=true, KAFKA_SASL_MECHANISM=PLAIN
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_ENABLED=false
KAFKA_SASL_MECHANISM=

# ── Document asset URLs (S3 / CloudFront-style signing at the BFF) ─────────────
# BFF appends doc_exp + doc_sig; CDN or Lambda@Edge must validate HMAC SHA-256(secret, canonicalResource|doc_exp).
# Production: use a strong random secret (≥16 chars).
DOCUMENT_ASSET_SIGNING_SECRET=
DOCUMENT_ASSET_SIGNING_TTL_SEC=3600
